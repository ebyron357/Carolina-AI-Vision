{
  "name": "next-tailwind-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typegen": "next typegen",
    "format": "prettier --write .",
    "test": "jest",
    "prepare": "husky",
    "lint:fix": "eslint --fix . && prettier --write .",
